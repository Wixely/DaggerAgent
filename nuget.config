<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the Wixely GitHub Packages feed alongside nuget.org so AgentClientProtocol (the
    Wixely/acp-csharp fork) and the Banter.* agent SDK (Wixely/Banter) restore. GitHub
    Packages requires authentication even to read: set GITHUB_PACKAGES_USER (a GitHub
    username) and GITHUB_PACKAGES_TOKEN (a PAT or the Actions GITHUB_TOKEN, with the
    read:packages scope). Credentials are taken from the environment so none are committed
    here.
  -->
  <packageSources>
    <add key="wixely-github" value="https://nuget.pkg.github.com/Wixely/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <wixely-github>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </wixely-github>
  </packageSourceCredentials>
</configuration>
