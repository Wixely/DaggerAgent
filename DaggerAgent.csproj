<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Daggeragent</RootNamespace>
    <AssemblyName>dagger</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Embed icon.ico in the PE header so Windows Explorer / taskbar show it on dagger.exe. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="publish/**" />
    <Content Remove="publish/**" />
    <EmbeddedResource Remove="publish/**" />
    <None Remove="publish/**" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Embed icon.ico as a manifest resource so the runtime can read its bytes
         (served at /favicon.ico, used to set the console window icon).
         The file ships only inside dagger.dll/dagger.exe — never as a sibling artifact. -->
    <EmbeddedResource Include="icon.ico" LogicalName="Dagger.icon.ico" />
    <None Remove="icon.ico" />
    <!-- Web UI assets. The LogicalName transform flattens subdirectories into dot-separated
         resource names: Server\Ui\core\api.js becomes Dagger.ui.core.api.js, which is what
         EmbeddedAssets.TryGetUiAsset looks up.

         Both separators have to be replaced. MSBuild fills %(RecursiveDir) with the host
         platform's separator, so it is "core\" on Windows and "core/" on Linux. Replacing
         only the backslash left "Dagger.ui.core/api.js" on the CI runners, which no lookup
         can match - every core module 404s and the UI dies on its first import. Nothing
         caught it earlier because Server\Ui had no subdirectories until core\ existed. -->
    <EmbeddedResource Include="Server\Ui\**\*"
                      LogicalName="Dagger.ui.$([System.String]::Copy('%(RecursiveDir)').Replace('\','.').Replace('/','.'))%(Filename)%(Extension)" />
    <None Remove="Server\Ui\**\*" />
    <Content Remove="Server\Ui\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <!-- ACP SDK from the Wixely/acp-csharp fork, published to that repo's GitHub Packages
         feed (see nuget.config). Requires a GitHub token with read:packages in
         GITHUB_PACKAGES_TOKEN to restore. -->
    <PackageReference Include="AgentClientProtocol" Version="0.2.0" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <!-- Direct pin, not used directly: Microsoft.ML.Tokenizers.Data.O200kBase 2.0.0 hard-pins
         Microsoft.Bcl.Memory 9.0.4, which carries GHSA-73j8-2gch-69rq (.NET DoS, affects
         >=9.0.0 <=9.0.13). The parent has not moved, so override the transitive here.
         Drop this once O200kBase ships a reference to 9.0.14+ / 10.0.4+. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.11" />
    <!-- 10.0.11 pulls SQLitePCLRaw.bundle_e_sqlite3 2.1.12, clearing GHSA-2m69-gcr7-jv3q
         (vulnerable SQLite in SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="OllamaSharp" Version="5.4.25" />
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.4.26230.115" />
  </ItemGroup>

</Project>
